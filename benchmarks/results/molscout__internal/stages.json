  "config_sha256": "4444b49529e8ff76ffadb440fe0e098db587199df9efbc8e9c4e0719380198e0",
  "config": {
    "readers": [
      "molglyph",
      "molscribe",
      "molnextr"
    ],
    "primary_reader": "molglyph",
    "joiner": "both",
    "opsin_jar": "opsin",
    "java": "${MOLSCOUT_STORE}/models/molvec/jdk/bin/java",
    "dpi": 300,
    "fixes": {
      "labels": true,
      "relevance": true,
      "tables": true,
      "core_check": true,
      "vote": true,
      "stereo": true,
      "junk": true,
      "names": true,
      "formulas": true,
      "attachments": true,
      "slot_labels": true,
      "legends": false,
      "partial_stereo": false
    },
    "thresholds": {
      "structure_score": 0.5
    },
    "export": "accepted",
    "allow_empty": [],
    "device": "gpu",
    "workers": {
      "cells": {
        "env": "decimer_ai",
        "worker": "cells.py",
        "args": [
          "--device",
          "{device}"
        ],
        "output": "cells.jsonl",
        "variables": []
      },
      "join_32b": {
        "env": "biominer",
        "worker": "join_32b.py",
        "args": [
          "--url",
          "{vllm_url}",
          "--wait",
          "60"
        ],
        "output": "molecules_32b.jsonl",
        "variables": []
      },
      "ocr_labels": {
        "env": "mineru",
        "worker": "ocr_labels.py",
        "args": [
          "--device",
          "cpu"
        ],
        "output": "ocr.jsonl",
        "variables": [
          "MINERU_HOME",
          "MINERU_TELEMETRY_DISABLED"
        ]
      },
      "parse": {
        "env": "mineru",
        "worker": "mineru_parse.py",
        "args": [
          "--tier",
          "standard",
          "--backend",
          "vllm",
          "--small-backend",
          "torch"
        ],
        "output": "layout.jsonl",
        "variables": [
          "MINERU_HOME",
          "MINERU_TELEMETRY_DISABLED"
        ]
      },
      "read_molglyph": {
        "env": "molglyph",
        "worker": "read_molglyph.py",
        "args": [
          "--checkpoint",
          "molglyph_large.pt",
          "--abbrevs",
          "abbrevs.csv",
          "--device",
          "{torch_device}"
        ],
        "output": "reads.jsonl",
        "variables": []
      },
      "read_molnextr": {
        "env": "molnextr",
        "worker": "read_molnextr.py",
        "args": [
          "--checkpoint",
          "molnextr_best.pth",
          "--pad-to-square",
          "--device",
          "{torch_device}"
        ],
        "output": "reads.jsonl",
        "variables": []
      },
      "read_molscribe": {
        "env": "molscribe",
        "worker": "read_molscribe.py",
        "args": [
          "--checkpoint",
          "swin_base_char_aux_1m680k.pth",
          "--device",
          "{torch_device}"
        ],
        "output": "reads.jsonl",
        "variables": []
      },
      "segment": {
        "env": "decimer_ai",
        "worker": "segment.py",
        "args": [
          "--device",
          "{device}"
        ],
        "output": "regions.jsonl",
        "variables": []
      }
    }
  },
