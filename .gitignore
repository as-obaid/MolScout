# Data: paper PDFs, dataset images and private files stay local
data/raw/*
!data/raw/.gitkeep

# Internal sponsor dataset: six benchmark PDFs and ground-truth SMILES, never committed
data/internal/

# Benchmark runs: SLURM logs, harness staging folders, checkpoints of unfinished runs and worker claims
benchmarks/slurm/logs/*
!benchmarks/slurm/logs/.gitkeep
benchmarks/results/.staging-*
benchmarks/results/.old-*
benchmarks/results/.checkpoints/
benchmarks/results/.claims/
# Internal predictions are SMILES from the private papers: never committed
benchmarks/results/*__internal/predictions.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# OS
.DS_Store

# W&B local run files
wandb/

# Docs: kept local until the public write-up
docs/
